# === アプリ設定 ===
APP_NAME=hackathon-backend
APP_ENV=development
APP_PORT=8080

# CORS許可（フロントエンドのURL）
FRONTEND_ORIGIN=http://localhost:3000

# === 外部API ===
OPENAI_API_KEY=your_openai_api_key

# === MySQL ===
# docker-compose の db サービスと backend アプリの両方がこれらを参照します
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_DATABASE=hackathon
MYSQL_USER=uttc
MYSQL_PASSWORD=your_db_password
MYSQL_PWD=your_db_password
MYSQL_ROOT_PASSWORD=your_db_root_password

# === Google / Firebase ===
# サービスアカウントJSONへのパス（リポジトリにはコミットしないこと）
FIREBASE_SERVICE_ACCOUNT_JSON=path/to/firebase_service_account.json
GOOGLE_APPLICATION_CREDENTIALS=path/to/service_account.json
